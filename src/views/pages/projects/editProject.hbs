<main class='container d-flex flex-column justify-content-center align-items-center p-5 gap-5'>

  <!-- Form section -->
  <section class='card w-100' style='max-width: 520px'>
    <div class='card-body'>
      <h3 class='text-center mb-4 text-dark'>Edit Project</h3>

      <form id='projectForm' id='projectForm' method='post' action='/projects/{{project.id}}?_method=PUT'
        enctype='multipart/form-data'>
        <!-- Project Name -->
        <div class='mb-3'>
          <label class='form-label text-dark fw-medium'>Project Name</label>
          <input type='text' name='name' required id='name' value='{{project.name}}' class='form-control'
            placeholder='Enter project name' />
          {{#if errors.name}}
          <div class="text-danger">
            {{errors.name}}
          </div>
          {{/if}}
        </div>

        <!-- Dates -->
        <div class='row'>
          <div class='col-md-6 mb-3'>
            <label class='form-label text-dark fw-medium'>Start Date</label>
            <input type='date' name='startDate' value={{project.start_date}} required id='startDate'
              class='form-control' />
            {{#if errors.startDate}}
            <div class="text-danger">
              {{errors.startDate}}
            </div>
            {{/if}}
          </div>
          <div class='col-md-6 mb-3'>
            <label class='form-label text-dark fw-medium'>End Date</label>
            <input type='date' name='endDate' value={{project.end_date}} required id='endDate' class='form-control' />
            {{#if errors.endDate}}
            <div class="text-danger">
              {{errors.endDate}}
            </div>
            {{/if}}
          </div>
        </div>

        <!-- Description -->
        <div class='mb-3'>
          <label class='form-label text-dark fw-medium'>Description</label>
          <textarea class='form-control' rows='4' name='description' required id='description'
            placeholder='Describe your project'>{{project.description}}
          </textarea>
          {{#if errors.description}}
          <div class="text-danger">
            {{errors.description}}
          </div>
          {{/if}}

        </div>

        <!-- Technologies -->
        <div class='mb-3' id='technologies'>
          <label class='form-label text-dark fw-medium d-block'>Technologies</label>
          {{#if errors.technologies}}
          <div class="text-danger">
            {{errors.technologies}}
          </div>
          {{/if}}
          {{#each technologies}}
          <div class='form-check'>
            <input class='form-check-input' type='checkbox' id={{this.id}} name='technologies' {{#if
              checked}}checked{{/if}} value={{this.id}} />
            <label class='form-check-label text-dark' for={{this.id}}>
              {{name}}
            </label>
          </div>
          {{/each}}

        </div>

        <!-- Image -->
        <div class='mb-4'>
          <label class='form-label text-dark fw-medium'>Upload Image</label>
          <input type='file' name='image' id='image' class='form-control mb-2' />
          {{#if errors.image}}
          <div class="text-danger">
            {{errors.image}}
          </div>
          {{/if}}
          <input type="hidden" name="existingImage" value="{{project.image}}" />
          <div class='mb-3'>
            <img id='imagePreview' class='img-fluid rounded ' alt='Preview Image' {{#if
              project.image}}src='/images/{{project.image}}' {{/if}} {{#if
              project.existingImage}}src='/images/{{project.existingImage}}' {{/if}} />

          </div>


          <small class='form-text text-muted'>
            Accepted formats: .jpg, .jpeg, .png (Max 2MB)
          </small>
        </div>

        <!-- Submit -->
        <button type='submit' class='btn btn-primary w-100 fw-medium'>
          Submit Project
        </button>
      </form>
    </div>
  </section>
</main>