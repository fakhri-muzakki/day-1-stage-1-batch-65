<main class="container" id="container">
  <h1 class="text-center fs-2 mb-4" id="projectName">Project Name</h1>
  <div class="card shadow-lg border-0 w-75 mx-auto">
    <div class="card-body">
      <!-- Top Content -->
      <div class="d-flex gap-4 align-items-start mb-4">
        <!-- Image -->
        <div class="mb-3 mb-md-0">
          <img
            id="image"
            src="/assets/images/sample.webp"
            alt="Project Image"
            width="380px"
            class="rounded"
          />
        </div>

        <!-- Content -->
        <div class="pt-2">
          <h5 class="fw-semibold mb-2">Duration</h5>
          <p class="text-muted mb-3 d-flex align-items-center gap-2">
            <i data-lucide="calendar" class="icon"></i>
            <span id="date">12 Jan 2025 - 12 Feb 2025</span>
          </p>

          <h5 class="fw-semibold mb-2">Technologies</h5>
          <div id="technologies">
            <span class="badge bg-secondary me-1">Next JS</span>
            <span class="badge bg-secondary me-1">TypeScript</span>
            <span class="badge bg-secondary me-1">Bootstrap</span>
          </div>
        </div>
      </div>

      <!-- Description -->
      <div>
        <h5 class="fw-semibold mb-2">Description</h5>
        <p class="text-muted mb-4" id="description">
          Lorem ipsum dolor sit amet, consectetur adipisicing elit. Quisquam
          nobis, laboriosam reprehenderit, amet facilis distinctio at ipsa
          reiciendis cupiditate, deleniti illo dignissimos doloremque
          perferendis. Adipisci accusantium sapiente eaque consequatur
          voluptatem.
        </p>

        <a href="/projects" class="btn btn-success"> Back </a>
      </div>
    </div>
  </div>
</main>

<script type="module" src="/js/detail-project.js"></script>