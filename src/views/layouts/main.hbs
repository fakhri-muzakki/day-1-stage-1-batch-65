<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous" />
  <link rel="stylesheet" href="/css/style.css" />
  <script src="https://unpkg.com/lucide@latest"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css" />

  <title>{{{title}}}</title>
</head>

<body class="bg-body-tertiary">
  <header class="mb-4">
    {{> navbar }}
  </header>

  {{{body}}}
  {{#if error}}
  <div class="flash-alert alert alert-danger fade show position-fixed shadow-sm d-flex justify-content-between"
    style="top: 20px; right: 20px; z-index: 1055; min-width: 280px;" role="alert">
    {{error}}
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
  {{/if}}

  {{#if success}}
  <div class="flash-alert alert alert-success fade show position-fixed shadow-sm d-flex justify-content-between"
    style="top: 20px; right: 20px; z-index: 1055; min-width: 280px;" role="alert">
    {{success}}
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
  {{/if}}

  <script type="module" src="/js/index.js"></script>
  {{!--
  <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script> --}}

  <script src="/js/removeAlert.js"></script>
  <script>
    lucide.createIcons();
  </script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
    crossorigin="anonymous"></script>
</body>

</html>